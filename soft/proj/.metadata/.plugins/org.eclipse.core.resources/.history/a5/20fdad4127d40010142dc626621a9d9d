#define CLION_MODE

#include <stdint.h>
#include <stdio.h>
#include <stdbool.h>
#include "axi_lw.h"

typedef uint32_t word_t;
typedef unsigned char sel_t;

#define LW_OFFSET_USER_INTERFACE 0x00010000
#define AXI_LW_USER_INTERFACE_REG(x) AXI_LW_REG(LW_OFFSET_USER_INTERFACE + x)

#define RAW_SIZE 5
#define MASK_RAW 0x1F

#define ROL(x, n) ( ((x) << (n * RAW_SIZE)) | ((x) >> (25 - (n * RAW_SIZE))) )

#define SEL_00 0x0
#define SEL_01 0x1
#define SEL_10 0x2
#define SEL_11 0x3

#define MASK_SW9_8 0x300
#define MASK_SW7_0 0x0FF
#define MASK_SW9_0 0x3FF

#define MASK_LEDS_SOC 0x3FF

#define MASK_STATUS 0x3


#define PATTERN_WRITE_01 0x33333333
#define PATTERN_WRITE_10 0xCCCCCCCC
#define PATTERN_WRITE_11 0xFFFFFFFF

//----Read Only-------------------------
// Read user id
#define REG_USER_ID AXI_LW_USER_INTERFACE_REG(0x0)
// Read switches
#define REG_SWITCHES AXI_LW_USER_INTERFACE_REG(0x8)
// Read Keys
#define REG_KEYS AXI_LW_USER_INTERFACE_REG(0x4)
// Read flg_we
#define FLG_WE (AXI_LW_USER_INTERFACE_REG(0x20) & 0x1) // return true if Max10 can be written
// Read max10 status
#define MAX10_STATUS (AXI_LW_USER_INTERFACE_REG(0x24) & MASK_STATUS)

//----Write Only-------------------------
// Write leds_SoC
#define REG_LEDS_SOC AXI_LW_USER_INTERFACE_REG(0xC)

//----Read and Write---------------------
// Read data state max10 zone 00
#define REG_DATA_00 AXI_LW_USER_INTERFACE_REG(0x10)
// Read data state max10 zone 01
#define REG_DATA_01 AXI_LW_USER_INTERFACE_REG(0x14)
// Read data state max10 zone 10
#define REG_DATA_10 AXI_LW_USER_INTERFACE_REG(0x18)
// Read data state max10 zone 11
#define REG_DATA_11 AXI_LW_USER_INTERFACE_REG(0x1C)

// rd_key : permet de lire la valeur d'un KEY spécifique
// Param : "key"= numéro du key qu'on veut lire (valeur dans [0;3])
// Return : True si le Key sélectionné est pressé False sinon
bool rd_key(unsigned char key);

// Permet de tester les flancs montant des Keys [0;3]
// Parameter : "key"= choix du Key auquel on veut tester le flanc montant (prend de 0 a 3)
bool rising_edge(unsigned char key);

// Parameter : "mask"= soit le MASK_SW9_8 soit le MASK_SW7_0 si un autre mask est utilisé, retourne la valeur des 10 switches
// Return : la valeur dans un int de la zone sélectionnée par le masque ([9..8], [7..0], [9..0])
word_t rd_switch(word_t mask);

// Parameter : "leds_data"= les valeurs a copier sur les LEDs du SoC (10 bits : leds_data[9..0])
void wr_leds_soc(word_t leds_data);

// Return : sur un int la valeur de key 0/1
// return[1] = Key 1, return[0] = Key 0
int rd_keys_0_1();

// Parameter : "leds_data"= valeurs a ecrire sur les leds (32 bits max)
// 			   "zone"     = zone de la carte Max10 ou ecrire les donnees [0 a 3]
//             "square_full"=
// false : on ecrit que les 8 premiers bits de leds_data a la ligne indiquee par la variable : square_shift
// true  : on copie les 32 bits de leds_data
void wr_max10_leds(word_t leds_data, sel_t zone, bool square_full);

// Etteint toute les LEDs de la carte Max10 (zone 0 a 3)
void wr_max10_leds_off();

// fait un retour a la ligne du modul carre de la Max10 : [0:4]
// met a jour la variable global : square_shift
void shift_square();

void read_val(int val);
